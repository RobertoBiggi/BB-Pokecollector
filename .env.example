# Copy to .env (ignored by git) and fill in. All optional.
# CardTrader -> Settings -> API. Without it, the script does not match the CardTrader blueprints.
CARDTRADER_TOKEN=
# Only for --d1 without `wrangler login`: Cloudflare token with the "D1: Edit" permission and the account id.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
