<?xml version="1.0" encoding="utf-8"?>
<!-- Android automatic backup (up to Android 11): database and settings, not the images (downloaded again) nor the
     CardTrader token (encrypted with a key from this phone's Keystore). -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <include domain="file" path="datastore/" />
    <exclude domain="file" path="datastore/secrets.preferences_pb" />
</full-backup-content>
