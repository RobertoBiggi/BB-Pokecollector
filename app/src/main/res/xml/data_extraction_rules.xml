<?xml version="1.0" encoding="utf-8"?>
<!-- Backup automatico Android 12+: database e impostazioni, non le immagini (si riscaricano). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
