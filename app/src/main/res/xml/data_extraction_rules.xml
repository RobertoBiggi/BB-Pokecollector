<?xml version="1.0" encoding="utf-8"?>
<!-- Backup automatico Android 12+: database e impostazioni, non le immagini (si riscaricano) né il token CardTrader
     (cifrato con una chiave del Keystore di questo telefono: altrove non si decifra, va reinserito). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
