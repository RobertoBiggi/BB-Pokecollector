<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ automatic backup: database and settings, not the images (downloaded again) nor the CardTrader token
     (encrypted with a key from this phone's Keystore: elsewhere it cannot be decrypted and must be entered again). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
